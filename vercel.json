{
  "functions": {
    "api/index.py": {
      "includeFiles": "data/kcg_laws.db"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/laws",
      "destination": "/static/list.html"
    },
    {
      "source": "/rules",
      "destination": "/static/list.html"
    },
    {
      "source": "/commentary",
      "destination": "/static/list.html"
    },
    {
      "source": "/search",
      "destination": "/static/search.html"
    },
    {
      "source": "/viewer",
      "destination": "/static/viewer.html"
    },
    {
      "source": "/admin/login",
      "destination": "/static/admin_login.html"
    },
    {
      "source": "/admin",
      "destination": "/static/admin.html"
    },
    {
      "source": "/",
      "destination": "/static/index.html"
    }
  ]
}
